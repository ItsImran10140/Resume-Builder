# Must match INTERNAL_SECRET in my-app/.env.local
INTERNAL_SECRET=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
# AI coach (OpenRouter recommended — use sk-or-v1-... key)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Legacy: OpenRouter keys stored here also work (sk-or-v1-...)
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/resumebuilder
