# Copy to .env.local and fill in values
# Note: Prisma CLI reads .env.local via dotenv-cli (see package.json db:* scripts)

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- NextAuth ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# OAuth (enable at least one in production)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only email login (no OAuth needed locally)
DEV_AUTH_EMAIL="you@example.com"

# --- FastAPI scorer (Railway / local) ---
SCORER_API_URL="http://localhost:8000"

# --- Upstash Redis (cache + BullMQ) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL="rediss://default:[password]@[host].upstash.io:6379"

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="resume-builder"
R2_PUBLIC_URL=""
